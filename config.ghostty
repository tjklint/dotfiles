# Ghostty terminal config
# Shared across machines. Linked into ~/.config/ghostty/config.ghostty by setup.sh.

# Synthwave vibes. Swap for Cyberpunk, Cobalt Neon, Laser, etc.
theme = Synthwave

# Notify when a command finishes, but only when the terminal is unfocused.
# Long-running commands are the whole reason to glance back at a terminal.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 15s

# Always show the tab bar so open tabs are never a surprise.
window-show-tab-bar = always

# GTK builds only: tabs fill their available space.
gtk-wide-tabs = true

# GTK builds only: compact tab bar, resolved relative to this file's directory.
gtk-custom-css = tabs.css

# Machine-specific overrides (fonts, sizes, opacity). The ? means this file is
# optional: create ~/.config/ghostty/local.conf per machine, or it is ignored.
# Must stay last so local.conf wins over the shared keys above.
config-file = ?local.conf
