# Ghostty terminal config
# Shared across machines. Linked into ~/.config/ghostty/config.ghostty by setup.sh.

# Notify when a command finishes, but only when the terminal is unfocused.
# Long-running commands are the whole reason to glance back at a terminal.
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 15s

# Always show the tab bar so open tabs are never a surprise.
window-show-tab-bar = always
